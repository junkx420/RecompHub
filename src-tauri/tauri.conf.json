{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecompHub",
  "version": "0.1.0",
  "identifier": "io.recomphub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RecompHub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https://raw.githubusercontent.com https://avatars.githubusercontent.com",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RecompHub contributors",
    "homepage": "https://github.com/junkx420/RecompHub",
    "license": "GPL-3.0-or-later",
    "category": "Game",
    "shortDescription": "Store for native PC ports of recompiled and decompiled games",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMzY3NjE1MjQ1NEQ2NzQKUldSMDFsUWtGWFkyelc3UnU1TmlHTHgwZy9sV1ZLcWxrOXNNOGRJbmJ6SEtENE00V2pxVXZMR00K",
      "endpoints": ["https://github.com/junkx420/RecompHub/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
